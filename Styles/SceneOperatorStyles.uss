/* Layout only — every color comes from the preferences (Edit > Preferences > Scene Operator). */

.so-root {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- toolbar */

.so-toolbar {
    flex-direction: row;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
}

.so-collection-button {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: 20px;
    margin: 0;
    padding-left: 6px;
    padding-right: 4px;
    background-color: rgba(0, 0, 0, 0.15);
    border-width: 0;
    border-radius: 3px;
}

.so-collection-button:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

.so-collection-label {
    flex-grow: 1;
    overflow: hidden;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.so-collection-arrow {
    width: 12px;
    height: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.so-icon-button {
    width: 20px;
    height: 20px;
    margin: 0;
    margin-left: 3px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.so-icon-button:hover:enabled {
    background-color: rgba(255, 255, 255, 0.12);
}

.so-icon-button:disabled {
    opacity: 0.35;
}

.so-toolbar-divider {
    height: 1px;
    margin-bottom: 2px;
}

/* ---------------------------------------------------------------- list */

.so-scroll {
    flex-grow: 1;
}

.so-row {
    flex-direction: row;
    align-items: center;
    padding-right: 4px;
}

.so-row-accent {
    width: 3px;
    height: 100%;
    margin-right: 5px;
}

.so-row-name {
    flex-grow: 1;
    overflow: hidden;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.so-row-dirty {
    margin: 0;
    padding: 0;
    margin-right: 4px;
    -unity-text-align: middle-center;
}

.so-row .so-icon-button {
    width: 18px;
    height: 18px;
    border-radius: 3px;
}

/* ---------------------------------------------------------------- groups */

.so-divider-wrapper {
    padding-top: 4px;
    padding-bottom: 2px;
}

.so-divider {
    height: 1px;
    margin-left: 8px;
    margin-right: 8px;
}

.so-group-label {
    font-size: 10px;
    margin: 0;
    padding: 0;
    padding-left: 8px;
    padding-top: 3px;
    padding-bottom: 1px;
    -unity-text-align: middle-left;
}

/* ---------------------------------------------------------------- empty state */

.so-empty {
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 18px;
    margin-left: 12px;
    margin-right: 12px;
}

.so-empty-button {
    align-self: center;
    margin-top: 10px;
    padding-left: 12px;
    padding-right: 12px;
    height: 22px;
}

/* ---------------------------------------------------------------- signature */

.so-signature {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 15px;
    font-size: 10px;
    opacity: 0.35;
}

.so-signature-icon {
    width: 13px;
    height: 13px;
    margin-left: 2px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}
